<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1779531631501-1" author="Mai Hien">
        <addColumn tableName="option_laptop">
            <column name="name" type="varchar(250)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="decimal(10,1)">
                <constraints nullable="false"/>
            </column>
            <column name="laptop_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="create_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="update_at" type="timestamp" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>